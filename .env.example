# Copy this file to .env locally (or export these in your shell) — never commit
# the real .env. In GitHub Actions these are set as repo Secrets instead
# (see README.md), not read from this file.

# Gmail app password recommended, not your normal Gmail password
SMTP_EMAIL=youraddress@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# At least one required. The vision engine spins up one dedicated worker
# thread per key you set (up to 20, GEMINI_API_KEY_1..GEMINI_API_KEY_20) and
# runs them in parallel, each paced independently to stay under its own
# per-minute quota — you don't need to fill in all 20, just as many as you
# have keys for.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
GEMINI_API_KEY_13=
GEMINI_API_KEY_14=
GEMINI_API_KEY_15=
GEMINI_API_KEY_16=
GEMINI_API_KEY_17=
GEMINI_API_KEY_18=
GEMINI_API_KEY_19=
GEMINI_API_KEY_20=
