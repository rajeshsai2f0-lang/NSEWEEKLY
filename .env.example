# Copy this file to .env locally (or export these in your shell) — never commit
# the real .env. In GitHub Actions these are set as repo Secrets instead
# (see README.md), not read from this file.

# Gmail app password recommended, not your normal Gmail password
SMTP_EMAIL=youraddress@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# At least one required — the vision engine rotates through them on quota errors
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
